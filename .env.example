# Poortconfiguratie (standaard 3000)
PORT=3000

# Optioneel: Sessie geheim voor token-ondertekening (wordt anders automatisch gegenereerd)
# SESSION_SECRET=your_random_32_byte_secret_here

# Optioneel: Brevo (Sendinblue) API-sleutel voor 2FA e-mailverificatie
# BREVO_API_KEY=your_brevo_api_key_here
# BREVO_SENDER_EMAIL=noreply@jouwdomein.nl
# BREVO_SENDER_NAME=Wat eten we
